{
  "name": "@moh-sso/ui",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts && node ../../scripts/write-package-declarations.mjs package ui",
