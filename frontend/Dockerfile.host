# Local Express host; compiled frontend assets are mounted by Compose.
FROM node:22-alpine
WORKDIR /app
COPY server/package*.json ./server/
RUN npm ci --prefix server --omit=dev --no-audit --no-fund
COPY server/*.mjs ./server/
ENV NODE_ENV=production HOST=0.0.0.0 IMPORT_MAP_FILE=/app/import-map.json
USER node
EXPOSE 3000
CMD ["node", "server/index.mjs"]
