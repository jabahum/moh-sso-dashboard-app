{
  "name": "@moh-sso/documents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./single-spa": {
      "types": "./dist/single-spa.d.ts",
      "import": "./dist/single-spa.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "version": "1.0.0",
  "license": "UNLICENSED",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts && node ../../scripts/write-package-declarations.mjs app documents",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "preview": "vite preview --config vite.config.ts"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "@moh-sso/api": "^1.0.0",
    "@moh-sso/microfrontend": "^1.0.0",
    "@moh-sso/ui": "^1.0.0",
    "@moh-sso/utils": "^1.0.0",
    "@moh-sso/auth": "^1.0.0",
    "@moh-sso/users": "~1.0.0"
  },
  "peerDependencies": {
    "@carbon/react": "^1.95.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "xlsx": "^0.18.5",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "single-spa": "^6.0.3"
  },
  "private": false
}
