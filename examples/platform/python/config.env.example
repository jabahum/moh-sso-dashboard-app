# Export these in the process environment; these examples do not auto-load .env.
OIDC_ISSUER=https://identity.example.org/realms/moh
PLATFORM_BASE_URL=https://portal.example.org/api/v1
APPLICATION_ID=pilot
APP_PUBLIC_URL=http://127.0.0.1:8081
APP_PORT=8081
# Optional when the interactive Keycloak client is confidential.
APP_CLIENT_SECRET=
# Dedicated service account bound to APPLICATION_ID; backend only.
MACHINE_CLIENT_ID=pilot-service
MACHINE_CLIENT_SECRET=replace-with-your-service-account-secret
