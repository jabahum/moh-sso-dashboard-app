# ==================================================
# Global
# ==================================================
ENVIRONMENT=development
GIN_MODE=debug

# ==================================================
# Frontend
# ==================================================
# Local frontend app is served under /portal
FRONTEND_BASE_URL=http://localhost:3000/portal
FRONTEND_REDIRECT_URI=http://localhost:3000/portal
AUTH_RETURN_URL_ALLOWED_ORIGINS=http://localhost:3000

# Backend API base exposed to browser/frontend.
# Useful if your frontend or config loader reads API_BASE_URL.
API_BASE_URL=http://localhost:9000

# IMPORTANT:
# Leave empty for localhost development.
# Do NOT use COOKIE_DOMAIN=localhost.
# Browser cookie Domain=localhost can cause cookies to be rejected/not returned.
COOKIE_DOMAIN=

# ==================================================
# Keycloak (Infrastructure)
# ==================================================
KEYCLOAK_VERSION=26.0.5

KEYCLOAK_DB=postgres
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Used by Keycloak container itself.
# For local development, keep hostname relaxed.
KEYCLOAK_HOSTNAME=localhost

# ==================================================
# Keycloak (Application / Backend usage)
# ==================================================

# Browser-facing Keycloak URL.
# This is what the user's browser is redirected to.
KEYCLOAK_EXTERNAL_URL=http://localhost:8081

# Backend/container-facing Keycloak URL.
# This is what the Go backend uses from inside Docker.
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

KEYCLOAK_REALM=moh-realm

# Backend login URL exposed to the browser.
LOGIN_URL=http://localhost:9000/api/v1/auth/login

# 🔐 Backend automation / service account client_credentials client
KEYCLOAK_ADMIN_CLIENT_ID=dashboard-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=dashboard-admin-secret

# 🌍 Web login authorization_code client
KEYCLOAK_WEB_CLIENT_ID=dashboard-web
KEYCLOAK_WEB_CLIENT_SECRET=dashboard-web-secret

# Must exactly match the redirect URI configured in Keycloak dashboard-web client.
KEYCLOAK_REDIRECT_URI=http://localhost:9000/api/v1/auth/callback

# ==================================================
# Backend (Go / Gin)
# ==================================================
SERVER_PORT=9000
APP_BASE_URL=http://localhost:9000

# ==================================================
# Health BI report integration
# ==================================================
# Base URL of the Health BI API used by the SSO report scheduler.
HEALTH_BI_BASE_URL=http://health-bi:8080
# Service token/credential. Leave empty only when Health BI is reachable through trusted internal auth.
HEALTH_BI_API_TOKEN=
HEALTH_BI_AUTH_HEADER=Authorization
HEALTH_BI_TIMEOUT=30s

# ==================================================
# RBAC / Keycloak Startup Sync
# ==================================================
# Apply portal permission mappings, then sync the local realm export and live Keycloak catalog into the portal RBAC DB.
# Keycloak remains the source of truth for users, passwords, and role assignments.
RBAC_STARTUP_SYNC_ENABLED=true
RBAC_STARTUP_SEED_ENABLED=true
RBAC_STARTUP_SEED_PATH=config/system-rbac.seed.yaml
RBAC_STARTUP_SYNC_REALM_EXPORT=true
RBAC_STARTUP_SYNC_REALM_EXPORT_PATH=
RBAC_STARTUP_SYNC_LIVE_KEYCLOAK=true
RBAC_STARTUP_SYNC_USERS=true

# Creates portal-defined missing Keycloak clients and realm/client roles from
# the RBAC system registry seed. User assignments are still explicit RBAC/Keycloak mappings.
RBAC_STARTUP_SYNC_PUSH_TO_KEYCLOAK=true

# Keep false for local/dev so backend boot is not blocked while Keycloak warms up.
RBAC_STARTUP_SYNC_FAIL_ON_ERROR=false

# ==================================================
# Backend Database
# ==================================================
DB_DRIVER=postgres
DB_HOST=backend-db
DB_PORT=5432
DB_NAME=sso_dashboard
DB_USER=postgres
DB_PASSWORD=postgres
DB_ENABLE_SSL=false

# ==================================================
# Redis
# ==================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================================================
# JWT / Auth (APP-SPECIFIC, NOT Keycloak)
# ==================================================
TOKEN_SYMMETRIC_KEY=supersecretkey12345678901234567890
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=720h

# ==================================================
# TLS (Disabled for Development)
# ==================================================
ENABLE_TLS=false
TLS_CERT=/app/certs/server.crt
TLS_KEY=/app/certs/server.key
TLS_KEYCLOAK_CA_CERT_PATH=/usr/local/share/ca-certificates/keycloak.crt

# ==================================================
# Upload Management
# ==================================================
REMOTE_DB_HOST=remote-postgres
REMOTE_DB_PORT=5432
REMOTE_DB_USER=jaba
REMOTE_DB_PASSWORD=12345678=j
REMOTE_DB_NAME=file_upload

# ==================================================
# Storage Management
# ==================================================
STORAGE_PROVIDER=local

# Local / NFS
LOCAL_BASE_PATH=/data/uploads
NFS_BASE_PATH=/mnt/nfs/uploads

# AWS S3
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# MinIO / S3-compatible
MINIO_REGION=us-east-1
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=

# ==================================================
# Visualiser
# ==================================================
DWH_HOST=remote-postgres
DWH_PORT=5432
DWH_USERNAME=jaba
DWH_PASSWORD=12345678=j
DWH_DB=file_upload

# ===================================================
# Email SMTP - Docker MailHog
# ===================================================
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@moh.go.ug
SMTP_FROM_NAME=MOH Integrated Health Portal
SMTP_CONNECT_TIMEOUT=10s
SMTP_SEND_TIMEOUT=15s
EMAIL_MAX_ATTACHMENTS=5
EMAIL_MAX_ATTACHMENT_BYTES=10485760
EMAIL_ALLOWED_ATTACHMENT_TYPES=pdf,doc,docx,xls,xlsx,csv,png,jpg,jpeg

ANNOUNCEMENT_MAX_ATTACHMENTS=10
ANNOUNCEMENT_MAX_ATTACHMENT_BYTES=10485760
ANNOUNCEMENT_ALLOWED_ATTACHMENT_TYPES=pdf,doc,docx,xls,xlsx,csv,png,jpg,jpeg

# ===================================================
# SMS Delivery
# ===================================================
# Local/dev default is disabled. Set SMS_ENABLED=true with SMS_PROVIDER=mock
# to test queue behavior without sending real SMS messages.
SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_DEFAULT_COUNTRY_CODE=+256
SMS_FROM_NAME=MOH
SMS_MAX_LENGTH=160
SMS_SEND_TIMEOUT=10s
NOTIFICATION_DELIVERY_WORKER_ENABLED=true
NOTIFICATION_DELIVERY_WORKER_INTERVAL=3s
NOTIFICATION_DELIVERY_BATCH_SIZE=20
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2s

# ===================================================
# System Admin Contact
# ===================================================
PLATFORM_NAME=MOH Integrated Health Portal
SYSTEM_ADMIN_EMAIL=admin@moh.go.ug
SYSTEM_ADMIN_NAME=System Administrator
ADMIN_DASHBOARD_URL=http://localhost:3000/portal/admin/home
