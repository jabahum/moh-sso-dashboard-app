# Local development environment
# Copy this example to app.env and replace placeholders.
# Keep the real app.env private; do not commit credentials.
# Values containing spaces or special characters should retain their existing quoting.

# ==================================================
# Application runtime
# ==================================================
ENVIRONMENT=development
GIN_MODE=debug
SERVER_PORT=9000
APP_BASE_URL=http://localhost:9000

# ==================================================
# Frontend and browser authentication
# ==================================================
# The frontend is served under /portal.
# Leave COOKIE_DOMAIN empty for localhost development.
FRONTEND_BASE_URL=http://localhost:3000/portal
FRONTEND_REDIRECT_URI=http://localhost:3000/portal
AUTH_RETURN_URL_ALLOWED_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:9000
LOGIN_URL=http://localhost:9000/api/v1/auth/login
COOKIE_DOMAIN=

# ==================================================
# Keycloak infrastructure
# ==================================================
# Settings for the Keycloak container and its database.
KEYCLOAK_VERSION=26.0.5
KEYCLOAK_DB=postgres
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HOSTNAME=localhost

# ==================================================
# Keycloak application clients
# ==================================================
# EXTERNAL_URL is browser-facing; BASE_URL and INTERNAL_URL must be reachable by the backend.
# ADMIN_CLIENT is the service account; WEB_CLIENT handles browser login.
# REDIRECT_URI must match the URI configured for the web client in Keycloak.
KEYCLOAK_EXTERNAL_URL=http://localhost:8081
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=moh-realm
KEYCLOAK_ADMIN_CLIENT_ID=dashboard-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=dashboard-admin-secret
KEYCLOAK_WEB_CLIENT_ID=dashboard-web
KEYCLOAK_WEB_CLIENT_SECRET=dashboard-web-secret
KEYCLOAK_REDIRECT_URI=http://localhost:9000/api/v1/auth/callback

# ==================================================
# RBAC startup synchronization
# ==================================================
# Keycloak is the source of truth for users, passwords, and role assignments.
# PUSH_TO_KEYCLOAK creates missing clients and roles from the RBAC registry seed.
# FAIL_ON_ERROR=false allows startup while Keycloak is unavailable.
RBAC_STARTUP_SYNC_ENABLED=true
RBAC_STARTUP_SEED_ENABLED=true
RBAC_STARTUP_SEED_PATH=config/system-rbac.seed.yaml
RBAC_STARTUP_SYNC_REALM_EXPORT=true
RBAC_STARTUP_SYNC_REALM_EXPORT_PATH=
RBAC_STARTUP_SYNC_LIVE_KEYCLOAK=true
RBAC_STARTUP_SYNC_PUSH_TO_KEYCLOAK=true
RBAC_STARTUP_SYNC_USERS=true
RBAC_STARTUP_SYNC_FAIL_ON_ERROR=false

# ==================================================
# Backend database
# ==================================================
DB_DRIVER=postgres
DB_HOST=backend-db
DB_PORT=5432
DB_NAME=sso_dashboard
DB_USER=postgres
DB_PASSWORD=postgres
DB_ENABLE_SSL=false

# ==================================================
# Redis
# ==================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================================================
# Application tokens
# ==================================================
# Application-specific signing key and token lifetimes.
TOKEN_SYMMETRIC_KEY=supersecretkey12345678901234567890
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=720h

# ==================================================
# TLS
# ==================================================
ENABLE_TLS=false
TLS_CERT=/app/certs/server.crt
TLS_KEY=/app/certs/server.key
TLS_KEYCLOAK_CA_CERT_PATH=/usr/local/share/ca-certificates/keycloak.crt

# ==================================================
# Upload management database
# ==================================================
REMOTE_DB_HOST=remote-postgres
REMOTE_DB_PORT=5432
REMOTE_DB_USER=jaba
REMOTE_DB_PASSWORD=12345678=j
REMOTE_DB_NAME=file_upload

# ==================================================
# Data warehouse / visualizer
# ==================================================
DWH_HOST=remote-postgres
DWH_PORT=5432
DWH_USERNAME=jaba
DWH_PASSWORD=12345678=j
DWH_DB=file_upload

# ==================================================
# File storage
# ==================================================
# Configure the credentials and paths for the selected STORAGE_PROVIDER.
STORAGE_PROVIDER=local
LOCAL_BASE_PATH=/data/uploads
NFS_BASE_PATH=/mnt/nfs/uploads
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MINIO_REGION=us-east-1
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=

# ==================================================
# Primary SMTP
# ==================================================
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@moh.go.ug
SMTP_FROM_NAME=MOH Integrated Health Portal
SMTP_CONNECT_TIMEOUT=10s
SMTP_SEND_TIMEOUT=15s

# ==================================================
# Email attachment limits
# ==================================================
EMAIL_MAX_ATTACHMENTS=5
EMAIL_MAX_ATTACHMENT_BYTES=10485760
EMAIL_ALLOWED_ATTACHMENT_TYPES=pdf,doc,docx,xls,xlsx,csv,png,jpg,jpeg

# ==================================================
# Announcement attachment limits
# ==================================================
ANNOUNCEMENT_MAX_ATTACHMENTS=10
ANNOUNCEMENT_MAX_ATTACHMENT_BYTES=10485760
ANNOUNCEMENT_ALLOWED_ATTACHMENT_TYPES=pdf,doc,docx,xls,xlsx,csv,png,jpg,jpeg

# ==================================================
# SMS delivery
# ==================================================
# Enable only after configuring a provider; use SMS_PROVIDER=mock for local testing.
SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_DEFAULT_COUNTRY_CODE=+256
SMS_FROM_NAME=MOH
SMS_MAX_LENGTH=160
SMS_SEND_TIMEOUT=10s

# ==================================================
# SMS provider: Africa's Talking
# ==================================================
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# ==================================================
# SMS provider: Twilio
# ==================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ==================================================
# Notification delivery worker
# ==================================================
NOTIFICATION_DELIVERY_WORKER_ENABLED=true
NOTIFICATION_DELIVERY_WORKER_INTERVAL=3s
NOTIFICATION_DELIVERY_BATCH_SIZE=20

# ==================================================
# Delivery retries
# ==================================================
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2s

# ==================================================
# Platform and administrator contact
# ==================================================
PLATFORM_NAME=MOH Integrated Health Portal
SYSTEM_ADMIN_NAME=System Administrator
SYSTEM_ADMIN_EMAIL=admin@moh.go.ug
ADMIN_DASHBOARD_URL=http://localhost:3000/portal/admin/home

# ==================================================
# Report Scheduler / Health BI integration
# ==================================================
# APP_BASE_URL must be browser-accessible for report delivery links.
# Application base, without ?report or /api/v1. Requires the Health BI scheduler adapter.
HEALTH_BI_BASE_URL=https://dashboards.health.go.ug/report-browser
# Dedicated confidential Keycloak service account; uses KEYCLOAK_BASE_URL and KEYCLOAK_REALM.
HEALTH_BI_KEYCLOAK_CLIENT_ID=report-scheduler-worker
HEALTH_BI_KEYCLOAK_CLIENT_SECRET=
HEALTH_BI_TIMEOUT=30s
REPORT_SCHEDULER_WORKER_INTERVAL=30s
REPORT_SCHEDULER_DELIVERY_LINK_TTL=24h
