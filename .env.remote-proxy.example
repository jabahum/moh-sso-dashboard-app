# Compose interpolation settings for Nginx on a separate machine.
# Copy to .env.remote-proxy and replace ALL example addresses/tags.
# Always use: docker compose --env-file app.env --env-file .env.remote-proxy -f docker-compose.yml ...
# This is the application server's PRIVATE interface IP, not the Nginx IP.
APP_BIND_ADDRESS=10.0.0.20
APP_ENV_FILE=./app.env
BACKEND_TAG=1.2.3
FRONTEND_TAG=1.2.3
