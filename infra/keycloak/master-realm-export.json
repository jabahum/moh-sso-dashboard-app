{
  "id": "master",
  "realm": "master",
  "enabled": true,
  "sslRequired": "none",
  "loginTheme": "moh-theme",
  "accountTheme": "moh-theme",
  "adminTheme": "moh-theme",
  "registrationAllowed": false,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": true,
  "bruteForceProtected": false,

  "clients": [
    {
      "clientId": "admin-cli",
      "name": "Admin CLI",
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true
    },
    {
      "clientId": "account",
      "name": "Account Management",
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": ["http://localhost:8081/*", "http://localhost:3000/*"],
      "webOrigins": ["*"],
      "standardFlowEnabled": true
    },
    {
      "clientId": "security-admin-console",
      "name": "Keycloak Admin Console",
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": ["http://localhost:8081/*"],
      "webOrigins": ["*"],
      "standardFlowEnabled": true
    }
  ],

  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "System",
      "lastName": "Administrator",
      "email": "admin@moh.go.ug",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    }
  ],

  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role with full access"
      }
    ]
  }
}
