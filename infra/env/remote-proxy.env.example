# Compose interpolation settings for Nginx on a separate machine.
# Copy to infra/env/remote-proxy.env and replace the example application private IP.
# Runtime settings and release tags come from the production env file (infra/env/prod.env).
# Always use: make compose-up COMPOSE_ENV=remote
# This is the application server's PRIVATE interface IP, not the Nginx IP.
APP_BIND_ADDRESS=10.0.0.20
