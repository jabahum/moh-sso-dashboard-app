# Compose interpolation settings for Nginx on a separate machine.
# Copy to .env.remote-proxy and replace the example application private IP.
# Runtime settings and release tags come from the preceding --env-file app.env.
# Always use: docker compose --env-file app.env --env-file .env.remote-proxy -f infra/compose/docker-compose.yml ...
# This is the application server's PRIVATE interface IP, not the Nginx IP.
APP_BIND_ADDRESS=10.0.0.20
