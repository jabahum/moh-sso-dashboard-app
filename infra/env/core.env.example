# Copy to infra/env/core.env; mount real secrets using the paths in the core
# Compose file. Do not commit operator settings or secrets.
DISTRIBUTION_TAG=0.0.0-core-local
PLATFORM_PROFILE=core
ENVIRONMENT=production
GIN_MODE=release
SERVER_PORT=9000
DEV_AUTH_BYPASS=false
ALLOW_INSECURE_HTTP=false
DB_USER=postgres
DB_NAME=sso_dashboard
# URLs must point to your actual identity provider and separately hosted shell.
KEYCLOAK_BASE_URL=https://identity.example.org
KEYCLOAK_INTERNAL_URL=https://identity.example.org
KEYCLOAK_EXTERNAL_URL=https://identity.example.org
KEYCLOAK_REALM=MoH
KEYCLOAK_ADMIN_CLIENT_ID=dashboard-admin
KEYCLOAK_WEB_CLIENT_ID=dashboard-web
KEYCLOAK_REDIRECT_URI=https://portal.example.org/ssobackend/api/v1/auth/callback
FRONTEND_BASE_URL=https://portal.example.org/
FRONTEND_REDIRECT_URI=https://portal.example.org/
LOGIN_URL=https://portal.example.org/ssobackend/api/v1/auth/login
APP_BASE_URL=https://portal.example.org/ssobackend
AUTH_RETURN_URL_ALLOWED_ORIGINS=https://portal.example.org
COOKIE_DOMAIN=portal.example.org
RBAC_STARTUP_SYNC_ENABLED=true
RBAC_STARTUP_SEED_ENABLED=true
RBAC_STARTUP_SYNC_REALM_EXPORT=false
RBAC_STARTUP_SYNC_LIVE_KEYCLOAK=false
RBAC_STARTUP_SYNC_PUSH_TO_KEYCLOAK=false
RBAC_STARTUP_SYNC_USERS=false
