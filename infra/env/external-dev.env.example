# Local application services with the production Keycloak server.
# Copy to infra/env/external-dev.env; fill both client secrets privately.
# Other development defaults come from dev.env.example. Add local DB/provider
# overrides here as needed; this file is also used for Compose interpolation.
ENVIRONMENT=development
DEV_AUTH_BYPASS=false
APP_BASE_URL=http://localhost:9000
FRONTEND_BASE_URL=http://localhost:3000/portal
FRONTEND_REDIRECT_URI=http://localhost:3000/portal
AUTH_RETURN_URL_ALLOWED_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:9000
LOGIN_URL=http://localhost:9000/api/v1/auth/login
COOKIE_DOMAIN=

KEYCLOAK_INTERNAL_URL=https://auth.health.go.ug
KEYCLOAK_BASE_URL=https://auth.health.go.ug
KEYCLOAK_EXTERNAL_URL=https://auth.health.go.ug
KEYCLOAK_REALM=MoH
KEYCLOAK_ADMIN_CLIENT_ID=dashboard-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_WEB_CLIENT_ID=dashboard-web
KEYCLOAK_WEB_CLIENT_SECRET=
# This exact callback must be registered on the external web client.
KEYCLOAK_REDIRECT_URI=http://localhost:9000/api/v1/auth/callback

RBAC_STARTUP_SYNC_REALM_EXPORT=false
RBAC_STARTUP_SYNC_PUSH_TO_KEYCLOAK=false
