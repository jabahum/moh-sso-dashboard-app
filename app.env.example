# ==================================================
# Production Compose Environment Example
# Copy to ./app.env on the server and replace placeholders.
# Do not commit the real ./app.env file.
# ==================================================

ENVIRONMENT=production
GIN_MODE=release

# Public portal URL. The frontend is served under /portal.
FRONTEND_BASE_URL=https://dashboards.health.go.ug/portal
FRONTEND_REDIRECT_URI=https://dashboards.health.go.ug/portal
AUTH_RETURN_URL_ALLOWED_ORIGINS=https://dashboards.health.go.ug
API_BASE_URL=/ssobackend
COOKIE_DOMAIN=dashboards.health.go.ug

# Browser-facing Keycloak URL.
KEYCLOAK_EXTERNAL_URL=https://auth.health.go.ug
KEYCLOAK_BASE_URL=https://auth.health.go.ug
KEYCLOAK_INTERNAL_URL=https://auth.health.go.ug
KEYCLOAK_REALM=moh-realm

LOGIN_URL=https://dashboards.health.go.ug/ssobackend/api/v1/auth/login
KEYCLOAK_ADMIN_CLIENT_ID=dashboard-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-secret-or-mounted-secret
KEYCLOAK_WEB_CLIENT_ID=dashboard-web
KEYCLOAK_WEB_CLIENT_SECRET=replace-with-secret-or-mounted-secret
KEYCLOAK_REDIRECT_URI=https://dashboards.health.go.ug/ssobackend/api/v1/auth/callback

SERVER_PORT=9000
# Public backend origin; required for secure Report Scheduler email delivery links.
APP_BASE_URL=https://dashboards.health.go.ug/ssobackend
REPORT_SCHEDULER_WORKER_INTERVAL=30s
REPORT_SCHEDULER_DELIVERY_LINK_TTL=24h

# RBAC / Keycloak startup sync.
RBAC_STARTUP_SYNC_ENABLED=true
RBAC_STARTUP_SEED_ENABLED=true
RBAC_STARTUP_SEED_PATH=config/system-rbac.seed.yaml
RBAC_STARTUP_SYNC_REALM_EXPORT=false
RBAC_STARTUP_SYNC_REALM_EXPORT_PATH=
RBAC_STARTUP_SYNC_LIVE_KEYCLOAK=true
RBAC_STARTUP_SYNC_USERS=true
RBAC_STARTUP_SYNC_PUSH_TO_KEYCLOAK=false
RBAC_STARTUP_SYNC_FAIL_ON_ERROR=false

# Backend database. DB_PASSWORD is also supplied to Postgres via ./secrets/db_password.txt.
DB_DRIVER=postgres
DB_HOST=backend-db
DB_PORT=5432
DB_NAME=sso_dashboard
DB_USER=postgres
DB_PASSWORD=replace-with-db-password
DB_ENABLE_SSL=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Application JWT/session signing key. Use a strong random value.
TOKEN_SYMMETRIC_KEY=replace-with-32-plus-character-secret
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=720h

ENABLE_TLS=false
TLS_CERT=/app/certs/server.crt
TLS_KEY=/app/certs/server.key
TLS_KEYCLOAK_CA_CERT_PATH=/usr/local/share/ca-certificates/keycloak.crt

# Upload / storage.
STORAGE_PROVIDER=local
LOCAL_BASE_PATH=/data/uploads
NFS_BASE_PATH=/mnt/nfs/uploads

# Optional remote warehouse / visualiser database.
REMOTE_DB_HOST=
REMOTE_DB_PORT=5432
REMOTE_DB_USER=
REMOTE_DB_PASSWORD=
REMOTE_DB_NAME=
DWH_HOST=
DWH_PORT=5432
DWH_USERNAME=
DWH_PASSWORD=
DWH_DB=

# Optional S3-compatible storage.
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MINIO_REGION=us-east-1
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=

# SMTP.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@moh.go.ug
SMTP_FROM_NAME=MOH Integrated Health Portal
SMTP_CONNECT_TIMEOUT=10s
SMTP_SEND_TIMEOUT=15s

# Dedicated Gmail / GM SMTP for Issue Assignment Emails
SMTP_HOST_GM=smtp.gmail.com
SMTP_PORT_GM=587
SMTP_USERNAME_GM=your-gmail-email@gmail.com
SMTP_PASSWORD_GM=your-gmail-app-password
SMTP_FROM_EMAIL_GM=your-gmail-email@gmail.com
SMTP_FROM_NAME_GM=MOH Issue Tracker
SMTP_CONNECT_TIMEOUT_GM=10s
SMTP_SEND_TIMEOUT_GM=15s
EMAIL_MAX_ATTACHMENTS=5
EMAIL_MAX_ATTACHMENT_BYTES=10485760
EMAIL_ALLOWED_ATTACHMENT_TYPES=pdf,doc,docx,xls,xlsx,csv,png,jpg,jpeg
ANNOUNCEMENT_MAX_ATTACHMENTS=10
ANNOUNCEMENT_MAX_ATTACHMENT_BYTES=10485760
ANNOUNCEMENT_ALLOWED_ATTACHMENT_TYPES=pdf,doc,docx,xls,xlsx,csv,png,jpg,jpeg

# SMS delivery. Keep disabled until a real provider account is configured.
SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_DEFAULT_COUNTRY_CODE=+256
SMS_FROM_NAME=MOH
SMS_MAX_LENGTH=160
SMS_SEND_TIMEOUT=10s
NOTIFICATION_DELIVERY_WORKER_ENABLED=true
NOTIFICATION_DELIVERY_WORKER_INTERVAL=3s
NOTIFICATION_DELIVERY_BATCH_SIZE=20
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2s

PLATFORM_NAME=MOH Integrated Health Portal
SYSTEM_ADMIN_EMAIL=admin@moh.go.ug
SYSTEM_ADMIN_NAME=System Administrator
ADMIN_DASHBOARD_URL=https://dashboards.health.go.ug/portal/admin/home
